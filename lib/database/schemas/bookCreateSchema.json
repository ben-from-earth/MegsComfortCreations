{
  "definitions": {},
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://example.com/root.json",
  "type": "object",
  "title": "The Book Create Schema",
  "required": ["title", "author", "spineColor", "imageUrls"],
  "properties": {
    "title": {
      "$id": "../properties/title",
      "type": "string",
      "title": "The Title Schema",
      "minLength": 1,
      "default": "",
      "examples": ["Dune"],
      "pattern": "^(.*)$"
    },
    "author": {
      "$id": "../properties/author",
      "type": "string",
      "title": "The Author Schema",
      "minLength": 1,
      "default": "",
      "examples": ["Frank Herbert"],
      "pattern": "^(.*)$"
    },
    "pageCount": {
      "$id": "../properties/pageCount",
      "type": "number",
      "title": "The Page Count Schema",
      "default": 0,
      "examples": [450]
    },
    "pubYear": {
      "$id": "../properties/pubYear",
      "type": "number",
      "title": "The Publication Year Schema",
      "default": 0,
      "examples": [1965]
    },
    "spineColor": {
      "$id": "../properties/spineColor",
      "type": "string",
      "title": "The Spine Color Schema",
      "minLength": 1,
      "default": "",
      "examples": ["#f25b26"],
      "pattern": "^(.*)$"
    },
    "imageUrls": {
      "$id": "../properties/imageUrls",
      "type": "array",
      "title": "The Image URL Schema",
      "minItems": 1,
      "default": [],
      "items": {
        "type": "string",
        "examples": ["http://imageurl1.com", "http://imageurl2.com"],
        "pattern": "^(.*)$"
      }
    }
  }
}
