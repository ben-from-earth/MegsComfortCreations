SERVER_BASE_URL = http://localhost:3000/api

GOOGLE_SEARCH_API_KEY = YourAPIKeyHere
GOOGLE_SEARCH_CX = YourCXHere

# App runtime DB URL
DATABASE_URL = postgresql://user:password@host/database?sslmode=require

# Use these env files for branch-safe migration workflow:
# - .env.development.local (Neon dev branch DATABASE_URL)
# - .env.production.local (Neon prod branch DATABASE_URL)
#
# Migration scripts:
# - npm run db:migrate:dev
# - npm run db:migrate:prod
# Verification scripts:
# - npm run db:check:dev
# - npm run db:check:prod

PG_PASSWORD = YourPGPasswordHere
PG_USERNAME = YourPGUsernameHere
DB_PORT = 5432