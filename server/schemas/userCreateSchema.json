{
  "definitions": {},
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://example.com/root.json",
  "type": "object",
  "title": "The User Create Schema",
  "required": ["email", "password"],
  "properties": {
    "email": {
      "$id": "../properties/email",
      "type": "string",
      "format": "email",
      "maxLength": 254,
      "title": "The Email Schema",
      "examples": ["john.doe@email.com"]
    },
    "password": {
      "$id": "../properties/password",
      "title": "The password schema",
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "allOf": [{ "pattern": "[A-Za-z]" }, { "pattern": "\\d" }],
      "description": "At least 8 characters, with at least one letter and one number.",
      "examples": ["correctpassword1"]
    },
    "first_name": {
      "$id": "../properties/first_name",
      "type": "string",
      "title": "The First Name Schema",
      "minLength": 1,
      "default": "",
      "examples": ["John"],
      "pattern": "^(.*)$"
    },
    "last_name": {
      "$id": "../properties/last_name",
      "type": "string",
      "title": "The Last Name Schema",
      "minLength": 1,
      "default": "",
      "examples": ["Doe"],
      "pattern": "^(.*)$"
    }
  }
}
