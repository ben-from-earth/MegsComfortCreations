{
  "definitions": {},
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://example.com/root.json",
  "type": "object",
  "title": "The Other Media Create Schema",
  "required": ["title", "image_urls", "spine_color"],
  "properties": {
    "title": {
      "$id": "#/properties/title",
      "type": "string",
      "title": "The Title Schema",
      "default": "",
      "examples": ["La La Land"],
      "pattern": "^(.*)$"
    },
    "image_urls": {
      "$id": "#/properties/image_urls",
      "type": "array",
      "title": "The Image URL Schema",
      "minItems": 1,
      "default": [],
      "items": {
        "type": "string",
        "examples": ["http://imageurl1.com", "http://imageurl2.com"],
        "pattern": "^(.*)$"
      }
    },
    "spine_color": {
      "$id": "#/properties/spine_color",
      "type": "string",
      "title": "The Spine Color Schema",
      "default": "",
      "examples": ["#ffffff"],
      "pattern": "^(.*)$"
    }
  }
}
