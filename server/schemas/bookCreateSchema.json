{
  "definitions": {},
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://example.com/root.json",
  "type": "object",
  "title": "The Root Schema",
  "required": ["title", "author", "spine_color", "image_urls"],
  "properties": {
    "title": {
      "$id": "#/properties/title",
      "type": "string",
      "title": "The Title Schema",
      "default": "",
      "examples": ["Dune"],
      "pattern": "^(.*)$"
    },
    "author": {
      "$id": "#/properties/author",
      "type": "string",
      "title": "The Author Schema",
      "default": "",
      "examples": ["Frank Herbert"],
      "pattern": "^(.*)$"
    },
    "page_count": {
      "$id": "#/properties/page_count",
      "type": "number",
      "title": "The Page Count Schema",
      "default": 0,
      "examples": [450]
    },
    "pub_year": {
      "$id": "#/properties/pub_year",
      "type": "number",
      "title": "The Publication Year Schema",
      "default": 0,
      "examples": [1965]
    },
    "spine_color": {
      "$id": "#/properties/spine_color",
      "type": "string",
      "title": "The Spine Color Schema",
      "default": "",
      "examples": ["#f25b26"],
      "pattern": "^(.*)$"
    },
    "image_urls": {
      "$id": "#/properties/image_urls",
      "type": "array",
      "title": "The Image URL Schema",
      "minItems": 1,
      "default": [],
      "items": {
        "type": "string",
        "examples": ["http://imageurl1.com", "http://imageurl2.com"],
        "pattern": "^(.*)$"
      }
    }
  }
}
